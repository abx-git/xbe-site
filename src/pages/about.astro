---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import EmailAddress from '../components/EmailAddress.astro';
import { about, pageMeta, siteConfig } from '../content/site';
---

<Layout title={pageMeta.about.title} description={pageMeta.about.description} path="/about">
  <PageIntro label="Meta" title={about.title} description={about.description} />
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="space-y-5 leading-relaxed text-text-muted">
      {about.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <dl class="mt-12 space-y-4 border-t border-border pt-10 text-sm">
      <div>
        <dt class="font-mono text-xs text-text-muted">E-Mail</dt>
        <dd class="mt-1"><EmailAddress class="text-text" /></dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-text-muted">LinkedIn</dt>
        <dd class="mt-1">
          <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer" class="text-accent-deep hover:underline">
            Profil ↗
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-text-muted">GitHub</dt>
        <dd class="mt-1">
          <a href={siteConfig.githubOrg} target="_blank" rel="noopener noreferrer" class="text-accent-deep hover:underline">
            abx-git ↗
          </a>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-xs text-text-muted">Ort</dt>
        <dd class="mt-1 text-text-muted">{siteConfig.location}</dd>
      </div>
    </dl>
  </article>
</Layout>
