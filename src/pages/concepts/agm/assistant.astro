---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import AgmAssistantEmbed from '../../../components/AgmAssistantEmbed.astro';
---

<Layout
  title="AGM Assistant — demo"
  description="Embedded AGM Assistant demonstrating the golden path."
  path="/concepts/agm/assistant"
>
  <PageIntro
    label="Demo · AGM"
    title="AGM Assistant"
    description="Embedded from abx-git.github.io/agm.github.io/. Session prompts and MCP hints."
  />
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="mb-6 text-sm text-text-muted">
      <a href="/concepts/agm" class="text-accent-deep hover:underline">← back to AGM concept</a>
    </p>
    <AgmAssistantEmbed />
  </div>
</Layout>
