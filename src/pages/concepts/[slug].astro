---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getConcept, getSortedConcepts } from '../../content/concepts';

export function getStaticPaths() {
  return getSortedConcepts().map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const concept = getConcept(slug!);
if (!concept) {
  return Astro.redirect('/concepts');
}

const related = concept.related
  .map((s) => getConcept(s))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<Layout title={concept.title} description={concept.oneLiner} path={`/concepts/${concept.slug}`}>
  <PageIntro label="Concept" title={concept.title} description={concept.oneLiner} />

  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 flex flex-wrap items-center gap-3">
      <StatusBadge status={concept.status} />
      <span class="font-mono text-xs text-text-muted">{concept.shortTitle}</span>
    </div>

    <section class="space-y-8">
      <div>
        <h2 class="text-sm font-semibold text-text">Problem</h2>
        <p class="mt-2 leading-relaxed text-text-muted">{concept.problem}</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-text">Approach</h2>
        <p class="mt-2 leading-relaxed text-text-muted">{concept.approach}</p>
      </div>
      <div>
        <h2 class="text-sm font-semibold text-text">Artifact</h2>
        <p class="mt-2 font-mono text-sm text-text">{concept.artifact.name}</p>
        <p class="mt-2 leading-relaxed text-text-muted">{concept.artifact.detail}</p>
      </div>
      {
        concept.paragraphs && concept.paragraphs.length > 0 && (
          <div class="space-y-4 border-t border-border pt-8">
            {concept.paragraphs.map((p) => (
              <p class="leading-relaxed text-text-muted">{p}</p>
            ))}
          </div>
        )
      }
      <div>
        <h2 class="text-sm font-semibold text-text">Try it</h2>
        <ul class="mt-3 space-y-2">
          {concept.demo.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-sm text-accent-deep hover:underline"
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external ? ' ↗' : ''}
              </a>
            </li>
          ))}
        </ul>
      </div>
      {
        related.length > 0 && (
          <div class="border-t border-border pt-8">
            <h2 class="text-sm font-semibold text-text">Related</h2>
            <ul class="mt-3 space-y-2">
              {related.map((r) => (
                <li>
                  <a href={`/concepts/${r.slug}`} class="text-sm text-accent-deep hover:underline">
                    {r.title}
                  </a>
                </li>
              ))}
              <li>
                <a href="/compose" class="text-sm text-accent-deep hover:underline">
                  Compose
                </a>
              </li>
            </ul>
          </div>
        )
      }
    </section>
  </article>
</Layout>
