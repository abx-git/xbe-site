---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import E2BoardEmbed from '../../../components/E2BoardEmbed.astro';
---

<Layout
  title="E2 Board — demo"
  description="Embedded E2 board for demonstration. Data stays local in the browser."
  path="/concepts/e2/board"
>
  <PageIntro
    label="Demo · E2"
    title="E2 Board"
    description="Embedded from abx-git.github.io/E2/. Board content stays local in your browser."
  />
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="mb-6 text-sm text-text-muted">
      <a href="/concepts/e2" class="text-accent-deep hover:underline">← back to E2 concept</a>
    </p>
    <E2BoardEmbed />
  </div>
</Layout>
