---
import Layout from '../../../layouts/Layout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import E2BoardEmbed from '../../../components/E2BoardEmbed.astro';
---

<Layout
  title="E2 Board — Demo"
  description="Eingebettetes E2 Board zur Demonstration. Daten bleiben lokal im Browser."
  path="/concepts/e2/board"
>
  <PageIntro
    label="Demo · E2"
    title="E2 Board"
    description="Eingebettet von abx-git.github.io/E2/. Board-Inhalt wird lokal im Browser gehalten."
  />
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="mb-6 text-sm text-text-muted">
      <a href="/concepts/e2" class="text-accent-deep hover:underline">← zurück zum Konzept E2</a>
    </p>
    <E2BoardEmbed />
  </div>
</Layout>
