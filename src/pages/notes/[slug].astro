---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getNoteBySlug, getSortedNotes, formatNoteDate } from '../../content/notes';

export function getStaticPaths() {
  return getSortedNotes().map((n) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params;
const note = getNoteBySlug(slug!);
if (!note) {
  return Astro.redirect('/notes');
}
---

<Layout title={note.title} description={note.excerpt} path={`/notes/${note.slug}`}>
  <PageIntro label="Note" title={note.title} description={note.excerpt} />
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="font-mono text-xs text-text-muted">{formatNoteDate(note.date)}</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {note.tags.map((tag) => (
        <span class="rounded border border-border px-2 py-0.5 font-mono text-[0.65rem] text-text-muted">{tag}</span>
      ))}
    </div>
    <div class="mt-10 space-y-5 leading-relaxed text-text-muted">
      {note.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <p class="mt-12 text-sm text-text-muted">
      <a href="/notes" class="text-accent-deep hover:underline">← Notes</a>
    </p>
  </article>
</Layout>
