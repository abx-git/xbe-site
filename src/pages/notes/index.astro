---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { notesIndex, getSortedNotes, formatNoteDate } from '../../content/notes';
import { pageMeta } from '../../content/site';

const articles = getSortedNotes();
---

<Layout title={pageMeta.notes.title} description={pageMeta.notes.description} path="/notes">
  <PageIntro label="Index" title={notesIndex.title} description={notesIndex.description} />
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <ul class="divide-y divide-border border-y border-border">
      {
        articles.map((article) => (
          <li class="py-8">
            <p class="font-mono text-[0.65rem] text-text-muted">{formatNoteDate(article.date)}</p>
            <h2 class="mt-2 text-xl font-semibold text-text">
              <a href={`/notes/${article.slug}`} class="hover:text-accent-deep">
                {article.title}
              </a>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{article.excerpt}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {article.tags.map((tag) => (
                <span class="font-mono text-[0.65rem] text-text-muted">{tag}</span>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
