---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { compose } from '../content/compose';
import { pageMeta } from '../content/site';
---

<Layout title={pageMeta.compose.title} description={pageMeta.compose.description} path="/compose">
  <PageIntro label="Option" title={compose.title} description={compose.description} />
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="space-y-4 text-base leading-relaxed text-text-muted">
      {compose.intro.map((p) => <p>{p}</p>)}
    </div>

    <ol class="mt-12 space-y-8">
      {
        compose.steps.map((step) => (
          <li class="flex gap-5">
            <span class="font-mono text-sm text-accent-deep">{step.n}</span>
            <div>
              <h2 class="text-base font-semibold text-text">{step.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-text-muted">{step.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <section class="mt-14 border-t border-border pt-10">
      <h2 class="text-sm font-semibold text-text">Offen</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-text-muted">
        {compose.open.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-sm font-semibold text-text">Weiter</h2>
      <ul class="mt-3 space-y-2">
        {
          compose.related.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-accent-deep hover:underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
