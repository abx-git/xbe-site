---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { getExample, getSortedExamples } from '../../content/examples';

export function getStaticPaths() {
  return getSortedExamples().map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const example = getExample(slug!);
if (!example) {
  return Astro.redirect('/examples');
}
---

<Layout title={example.title} description={example.summary} path={`/examples/${example.slug}`}>
  <PageIntro label="Beispiel" title={example.title} description={example.summary} />
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <StatusBadge status={example.status} />
    <div class="mt-8 space-y-5 leading-relaxed text-text-muted">
      {example.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <section class="mt-12 border-t border-border pt-8">
      <h2 class="text-sm font-semibold text-text">Links</h2>
      <ul class="mt-3 space-y-2">
        {
          example.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-mono text-sm text-accent-deep hover:underline"
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
                {link.external ? ' ↗' : ''}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
