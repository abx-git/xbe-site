---
interface Props {
  label?: string;
  title: string;
  description?: string;
}

const { label, title, description } = Astro.props;
---

<header class="border-b border-border bg-bg-elevated">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    {
      label && (
        <div class="section-label !mb-3">
          <span>{label}</span>
        </div>
      )
    }
    <h1 class="display-md text-text">{title}</h1>
    {description && <p class="mt-4 max-w-2xl text-base leading-relaxed text-text-muted">{description}</p>}
  </div>
</header>
